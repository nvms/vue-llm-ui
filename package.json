{
  "name": "vue-llm-ui",
  "version": "0.5.0",
  "type": "module",
  "description": "Vue 3 component for rendering streamed LLM text with embedded interactive blocks",
  "author": "Jonathan Pyers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nvms/vue-llm-ui"
  },
  "keywords": [
    "vue",
    "llm",
    "streaming",
    "markdown",
    "ai",
    "chatbot",
    "components",
    "blocks"
  ],
  "main": "./dist/vue-llm-ui.umd.cjs",
  "module": "./dist/vue-llm-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-llm-ui.js",
      "require": "./dist/vue-llm-ui.umd.cjs"
    },
    "./style.css": "./dist/vue-llm-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vite build --mode library && npm run build:types",
    "build:types": "vue-tsc src/index.ts --declaration --emitDeclarationOnly --outDir dist --skipLibCheck --moduleResolution bundler --module esnext",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "jsonrepair": "^3.12.0",
    "markdown-it": "^14.1.0",
    "shiki": "^3.7.0",
    "shiki-stream": "^0.1.2"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "shiki": "^3.7.0",
    "shiki-stream": "^0.1.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vue": "^3.5.17",
    "vue-tsc": "^2.2.10"
  }
}
